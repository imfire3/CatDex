OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
PORT=8787

# Supabase — verify analyze-cat Bearer tokens (required in production)
SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → JWT Secret (HS256 projects)
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Dashboard → Project Settings → API → service_role (server only — never EXPO_PUBLIC_)
# Required for DELETE /account (App Store account deletion)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Rate limit + payload caps
# ANALYZE_RATE_LIMIT=20
# ANALYZE_MAX_BYTES=5000000

# Local DEV — allow analyze without JWT when secret/JWKS misconfigured
# (forced OFF when NODE_ENV=production). Set to 0 to require Bearer JWT locally.
ALLOW_UNAUTH_ANALYZE=1

# Optional cutout
# SKIP_CUTOUT=1
# CUTOUT_BUDGET_MS=1200

# Admin stats dashboard (GET /admin?key=… and GET /admin/stats)
# Generate a long random string; never commit the real value.
ADMIN_STATS_SECRET=change-me-to-a-long-random-secret
